{
  "name": "@fungi.computer/trellis",
  "version": "0.0.1",
  "scripts": {
    "build": "vite build && tsc -p backend/tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p backend/tsconfig.json --noEmit",
    "lint": "eslint src test backend --max-warnings=0",
    "rebuild-copies": "node --import tsx scripts/rebuild-copies.mjs"
  },
  "dependencies": {
    "@fungi.computer/puffball": "0.0.2",
    "@cfworker/json-schema": "4.1.1",
    "@fungi.computer/agar": "0.1.0",
    "@fungi.computer/caps": "0.0.2",
    "@fungi.computer/stipe": "0.0.1",
    "@xyflow/react": "12.12.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@fungi.computer/braid": "0.0.1",
    "effect": "4.0.2",
    "@fungi.computer/sigils": "0.0.1",
    "lucide-react": "0.460.0",
    "zod": "4.4.3",
    "@fungi.computer/workflows-wire": "0.0.1",
    "@fungi.computer/cairn": "0.0.1",
    "@fungi.computer/watchdog": "0.0.1",
    "@fungi.computer/maosaico": "0.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260828.1",
    "@ladle/react": "5.1.1",
    "@tailwindcss/vite": "4.2.1",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "4.1.11",
    "eslint": "10.9.1",
    "tsx": "4.23.12",
    "jsdom": "29.0.1",
    "@types/node": "24.13.3",
    "@tailwindcss/cli": "4.2.1"
  },
  "fungi": {
    "build": {
      "stylesheets": [
        "src/trellis.css"
      ],
      "react": true
    },
    "backendDefinition": "backend/methods.ts",
    "app": {
      "displayName": "Trellis",
      "icon": "run",
      "capabilities": [
        "computer.list",
        "computer.readFile",
        "computer.writeFile",
        "media.generation",
        "workflow.run",
        "workflow.publish",
        "workflow.arm",
        "git.repository",
        "agent.read"
      ],
      "handlers": [],
      "roles": [],
      "backend": {
        "bindings": [
          {
            "name": "GIT",
            "operations": [
              "read",
              "write",
              "create",
              "exchange"
            ]
          },
          {
            "name": "WORKFLOWS",
            "operations": [
              "catalog",
              "runGraph",
              "graphStatus",
              "cancel",
              "answerReview",
              "armSchedule",
              "disarmSchedule",
              "schedules",
              "armEventTrigger",
              "disarmEventTrigger",
              "eventTriggers",
              "runs"
            ]
          },
          {
            "name": "INBOX",
            "operations": [
              "page"
            ]
          }
        ]
      }
    }
  },
  "description": "Trellis: build and run workflows of App methods, an App for Oyster",
  "author": "Levi <levi@technomancy.dev>",
  "type": "module",
  "exports": {
    "./backend": "./backend/index.ts",
    "./library": {
      "types": "./backend/library.ts",
      "import": "./dist/backend/library.js"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fungi-computer/trellis.git"
  },
  "botanical": {
    "role": "app",
    "operations": {
      "lint": "required",
      "typecheck": "required",
      "build": "required",
      "test": "required",
      "docs": {
        "status": "not-applicable",
        "reason": "Private first-party App"
      },
      "pack": {
        "status": "not-applicable",
        "reason": "Delivered as captured HTML"
      },
      "smoke": {
        "status": "not-applicable",
        "reason": "Browser proof exercises the App"
      },
      "stranger": {
        "status": "not-applicable",
        "reason": "Private first-party App"
      }
    }
  },
  "files": [
    "dist/backend",
    "dist/shared",
    "backend",
    "shared",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "pnpm@11.24.0"
}
