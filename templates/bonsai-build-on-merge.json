{
  "id": "bonsai-build-on-merge",
  "definition": {
    "format": "fungi.workflow/v1",
    "title": "Build on merge",
    "description": "An accepted main push for a registered App starts this Workflow through the Workflows capability. Build the exact accepted commit, verify its completed build and Release provenance, then install with Workflow-owned authority. Every step records its result. A failed build or verification never installs; new permissions preserve the running Release and require owner consent.",
    "apps": {
      "bonsai": {
        "appId": "app_bonsai"
      }
    },
    "input": {
      "type": "object",
      "properties": {
        "appId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sourceRevision": {
          "type": "string",
          "pattern": "^git:[0-9a-f]{40}$",
          "minLength": 44,
          "maxLength": 44
        },
        "installationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": ["appId", "sourceRevision", "installationId"],
      "additionalProperties": false
    },
    "nodes": [
      {
        "id": "build",
        "kind": "app",
        "app": "bonsai",
        "method": "apps.build",
        "methodDigest": "sha256:7acacb662de327c6ee7f4f07210bf63d174c457dc0032be529542df76314829f",
        "values": {
          "appId": {
            "from": {
              "node": "$input",
              "port": "appId"
            }
          },
          "sourceRevision": {
            "from": {
              "node": "$input",
              "port": "sourceRevision"
            }
          },
          "installationId": {
            "from": {
              "node": "$input",
              "port": "installationId"
            }
          }
        }
      },
      {
        "id": "verify",
        "kind": "app",
        "app": "bonsai",
        "method": "apps.verifyBuild",
        "methodDigest": "sha256:0ca6e1984a98c75ff18788dc1997c00496ae84a3723b74004ac325a095f72fb5",
        "values": {
          "jobId": {
            "from": {
              "node": "build",
              "port": "jobId"
            }
          },
          "sourceRevision": {
            "from": {
              "node": "$input",
              "port": "sourceRevision"
            }
          }
        }
      },
      {
        "id": "install",
        "kind": "app",
        "app": "bonsai",
        "method": "apps.install",
        "methodDigest": "sha256:3dcf4113653bf8427bbeb4351fc79649108d4624e3c5aa8a5148d0d323501fc6",
        "values": {
          "installationId": {
            "from": {
              "node": "$input",
              "port": "installationId"
            }
          },
          "release": {
            "from": {
              "node": "verify",
              "port": "release"
            }
          },
          "jobId": {
            "from": {
              "node": "build",
              "port": "jobId"
            }
          }
        }
      }
    ],
    "edges": [],
    "output": {
      "installation": {
        "node": "install",
        "port": "value"
      }
    }
  },
  "layout": {
    "build": {
      "x": 40,
      "y": 100
    },
    "verify": {
      "x": 340,
      "y": 100
    },
    "install": {
      "x": 640,
      "y": 100
    }
  }
}
